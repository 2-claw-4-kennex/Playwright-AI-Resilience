    "prepublishOnly": "npm run build",
    "harness": "ts-node tests/harness.ts"
  },
  "keywords": [
    "playwright",
    "testing",
    "selector",
    "flaky",
    "ci",
    "resilience",
    "recovery",
    "automation"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.0.0",
    "jsdom": "^24.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/playwright-ai-resilience"
